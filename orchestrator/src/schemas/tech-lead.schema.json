{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "instruction", "task_specific_tests", "blockers", "human_action"],
  "properties": {
    "decision": { "enum": ["IMPLEMENT", "PASS", "CODEX_FIX", "DEEP_REVIEW_REQUIRED", "HUMAN_ACTION_REQUIRED", "BLOCKED"] },
    "summary": { "type": "string" },
    "instruction": { "type": "string" },
    "task_specific_tests": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "human_action": { "type": ["object", "null"], "properties": { "title": { "type": "string" }, "explanation": { "type": "string" }, "why_manual": { "type": "string" }, "service": { "type": "string" }, "steps": { "type": "array", "items": { "type": "string" } }, "expected_result": { "type": "string" } }, "required": ["title", "explanation", "why_manual", "service", "steps", "expected_result"], "additionalProperties": false }
  }
}
